---
import ArticleCard from "../../components/ArticleCard.astro";
import Base from "../../layouts/Base.astro";
import { cachePage, getCategories, getMenu, listArticles, type Hints } from "../../lib/data";
import { isLocale, t } from "../../lib/i18n";

const { locale } = Astro.params;
if (!isLocale(locale)) return Astro.rewrite("/404");

const hints: Hints = [];
const menu = await getMenu(locale, hints);
const categories = await getCategories(locale, hints);
const sections = (
	await Promise.all(
		categories.map(async (category) => ({
			category,
			articles: await listArticles(locale, category.slug, 1, 3, hints),
		})),
	)
).filter((s) => s.articles.length > 0);
cachePage(Astro.cache, hints);
---

<Base locale={locale} menu={menu}>
	{
		sections.map(({ category, articles }) => (
			<section class="section">
				<h2>{category.label}</h2>
				<div class="articles-list">
					{articles.map((article) => (
						<ArticleCard locale={locale} article={article} />
					))}
				</div>
				<a href={`/${locale}/category/${category.slug}`} class="button">
					{t(locale).allIn(category.label)}
				</a>
			</section>
		))
	}
</Base>
