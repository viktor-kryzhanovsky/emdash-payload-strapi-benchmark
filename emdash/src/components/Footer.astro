---
import type { Menu } from "emdash";

import { t, type Locale } from "../lib/i18n";
import MenuLinks from "./MenuLinks.astro";

interface Props {
	locale: Locale;
	menu: Menu | null;
}

const { locale, menu } = Astro.props;
---

<footer class="footer">
	<nav class="footer-nav">
		<MenuLinks menu={menu} />
	</nav>
	<p class="copy">© {new Date().getFullYear()} {t(locale).rights}</p>
</footer>
