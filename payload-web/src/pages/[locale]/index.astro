---
import ArticleCard from "../../components/ArticleCard.astro";
import Base from "../../layouts/Base.astro";
import { getCategories, getMenu, listArticles } from "@/lib/data";
import { isLocale, t } from "../../lib/i18n";

const { locale } = Astro.params;
if (!isLocale(locale)) return Astro.rewrite("/404");

const menu = await getMenu(locale);
const categories = await getCategories(locale);
const sections = (
	await Promise.all(
		categories.map(async (category) => ({
			category,
			articles: (await listArticles(locale, category.id, 1, 3)).items,
		})),
	)
).filter((s) => s.articles.length > 0);
---

<Base locale={locale} menu={menu}>
	{
		sections.map(({ category, articles }) => (
			<section class="section">
				<h2>{category.title}</h2>
				<div class="articles-list">
					{articles.map((article) => (
						<ArticleCard locale={locale} article={article} />
					))}
				</div>
				<a href={`/${locale}/category/${category.slug}`} class="button">
					{t(locale).allIn(category.title)}
				</a>
			</section>
		))
	}
</Base>
