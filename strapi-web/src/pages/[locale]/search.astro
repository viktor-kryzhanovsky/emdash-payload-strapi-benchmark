---
import ArticleCard from "../../components/ArticleCard.astro";
import Pagination from "../../components/Pagination.astro";
import Base from "../../layouts/Base.astro";
import { getMenu, searchArticles } from "../../lib/data";
import { isLocale, parsePage, t } from "../../lib/i18n";

const { locale } = Astro.params;
if (!isLocale(locale)) return Astro.rewrite("/404");

const menu = await getMenu(locale);
const q = (Astro.url.searchParams.get("q") ?? "").trim();
const dict = t(locale);
const result = q ? await searchArticles(locale, q, parsePage(Astro.url.searchParams.get("page"))) : null;
---

<Base locale={locale} menu={menu}>
	<section class="section">
		<h1>{q ? dict.searchResults(q) : dict.search}</h1>
		<form class="search-form" action={`/${locale}/search`}>
			<input type="search" name="q" value={q} placeholder={dict.searchPlaceholder} />
			<button type="submit" class="button">{dict.search}</button>
		</form>
		{result && result.items.length === 0 && <p class="empty">{dict.nothingFound}</p>}
		{
			result && (
				<>
					<div class="articles-grid">
						{result.items.map((article) => (
							<ArticleCard locale={locale} article={article} />
						))}
					</div>
					<Pagination
						locale={locale}
						page={result.page}
						totalPages={result.totalPages}
						baseHref={`/${locale}/search?q=${encodeURIComponent(q)}`}
					/>
				</>
			)
		}
	</section>
</Base>
