---
// Renders Strapi "blocks" rich text (the JSON format of the blocks field).
import type { Block } from "../lib/data";

interface Props {
	blocks: Block[];
}

const { blocks } = Astro.props;
const headings = { 1: "h1", 2: "h2", 3: "h3", 4: "h4", 5: "h5", 6: "h6" } as const;
---

{
	blocks.map((block) => {
		const children = block.children ?? [];
		if (block.type === "heading") {
			const Tag = headings[(block.level ?? 2) as keyof typeof headings];
			return <Tag><Astro.self blocks={children} /></Tag>;
		}
		if (block.type === "list") {
			const Tag = block.format === "ordered" ? "ol" : "ul";
			return <Tag><Astro.self blocks={children} /></Tag>;
		}
		if (block.type === "list-item") return <li><Astro.self blocks={children} /></li>;
		if (block.type === "quote") return <blockquote><Astro.self blocks={children} /></blockquote>;
		if (block.type === "link") return <a href={block.url}><Astro.self blocks={children} /></a>;
		if (block.type === "text") {
			let text: unknown = block.text;
			if (block.code) text = <code>{text}</code>;
			if (block.bold) text = <strong>{text}</strong>;
			if (block.italic) text = <em>{text}</em>;
			if (block.underline) text = <u>{text}</u>;
			if (block.strikethrough) text = <s>{text}</s>;
			return text;
		}
		return <p><Astro.self blocks={children} /></p>;
	})
}
